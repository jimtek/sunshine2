{
  "uid": "gpu-researcher",
  "title": "GPU platform: researchers",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "tags": [
    "gpu-platform"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "team",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "includeAll": true,
        "multi": true,
        "query": "label_values(kueue_pending_workloads, cluster_queue)",
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "GPUs my team is using",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(platform:gpu_allocated:sum_by_team{cluster_queue=~\"$team\"})"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Jobs waiting",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(platform:pending_workloads:sum_by_team{cluster_queue=~\"$team\"})"
        }
      ]
    },
    {
      "type": "stat",
      "title": "P90 queue wait",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(platform:queue_wait_seconds:p90_by_team{cluster_queue=~\"$team\"})"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Fleet allocation",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform:gpu_allocation:ratio"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GPUs in use by team",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform:gpu_allocated:sum_by_team{cluster_queue=~\"$team\"}",
          "legendFormat": "{{cluster_queue}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Jobs waiting by team",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform:pending_workloads:sum_by_team{cluster_queue=~\"$team\"}",
          "legendFormat": "{{cluster_queue}}"
        }
      ]
    },
    {
      "type": "table",
      "title": "My experiments: GPUs held and utilization",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform:gpus_held:sum_by_experiment{namespace=~\"$team\"} or platform:gpu_utilization:avg_by_experiment{namespace=~\"$team\"}",
          "format": "table",
          "instant": true
        }
      ]
    }
  ]
}
