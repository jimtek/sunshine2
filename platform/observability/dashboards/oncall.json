{
  "uid": "gpu-oncall",
  "title": "GPU platform: on-call",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "tags": [
    "gpu-platform"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Allocation",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform:gpu_allocation:ratio"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Utilization (allocated)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform:gpu_utilization:avg"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Job success",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform:job_success:ratio"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Nodes with hardware faults",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(kube_node_status_condition{condition=\"AcceleratedHardwareReady\",status=\"false\"} == 1) or vector(0)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GPU capacity vs allocated by pool",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform:gpu_capacity:sum_by_pool or label_replace(platform:gpu_allocated:sum_by_flavor, \"label_platform_gpu_pool\", \"$1 (allocated)\", \"flavor\", \"(.*)\")",
          "legendFormat": "{{label_platform_gpu_pool}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Evictions by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform:evictions:rate1h_by_reason * 3600",
          "legendFormat": "{{cluster_queue}} {{reason}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "XID errors",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (Hostname, gpu) (DCGM_FI_DEV_XID_ERRORS) > 0",
          "legendFormat": "{{Hostname}} gpu{{gpu}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "P90 queue wait by team",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform:queue_wait_seconds:p90_by_team",
          "legendFormat": "{{cluster_queue}}"
        }
      ]
    }
  ]
}
